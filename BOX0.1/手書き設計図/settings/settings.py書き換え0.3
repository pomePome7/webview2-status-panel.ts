class AmazonAccountType(Enum):
    """Amazonアカウントタイプの定義"""
    SELLER_ESTABLISHED = "seller_established" # 既存のSeller Central出品者
    BUSINESS_ESTABLISHED = "business_established" # 既存のBusinessアカウント
    SELLER_NEW = "seller_new" # 新規出品者（出品デビュー）
    CONSUMER = "consumer" # 一般消費者アカウント
    
    @property
    def display_name(self):
        """表示用の日本語名"""
        names = {
            "seller_established": "Seller Central（既存出品者）",
            "business_established": "Amazon Business（既存法人）",
            "seller_new": "Amazon出品デビュー（新規）",
            "consumer": "通常のAmazon（一般）"
        }
        return names.get(self.value, self.value)
    
    @property
    def login_url(self):
        """アカウントタイプ別のログインURL
        注意: 一般ユーザーの場合はトップページから「アカウント＆リスト」をクリックする必要がある
        """
        urls = {
            "seller_established": "https://sellercentral.amazon.co.jp/ap/signin",
            "business_established": "https://www.amazon.co.jp/business/register/org/landing",
            "seller_new": "https://sell.amazon.co.jp/",
            "consumer": "https://www.amazon.co.jp/"  # トップページから遷移
        }
        return urls.get(self.value)
    
    @property
    def requires_setup(self):
        """初期設定が必要かどうか"""
        return self.value == "seller_new"
    
    @property
    def needs_account_list_click(self):
        """「アカウント＆リスト」のクリックが必要かどうか"""
        return self.value == "consumer"

# 設定管理クラス
class AppSettings:
    def __init__(self, organization_name="YourCompany", application_name="ECLoginApp"):
        # アプリケーション情報の設定
        self.organization_name = organization_name
        self.application_name = application_name
                
        # QSettingsオブジェクトの初期化
        self.settings = QSettings(self.organization_name, self.application_name)
        
        # デフォルト設定
        self.default_settings = {
            "accounts": {},
            "selected_sites": ["楽天市場"],
            "auto_login": False,
            "remember_accounts": True,
            "default_account": "",
            "api_key": "",
            "application_id": "",
            "affiliate_id": ""
        }
        
    def load_settings(self):
        # 保存された設定を読み込む
        settings_dict = {}
        
        # アカウント情報の読み込み
        settings_dict["accounts"] = {}
        self.settings.beginGroup("accounts")
        account_ids = self.settings.childGroups()
        for account_id in account_ids:
            self.settings.beginGroup(account_id)
            settings_dict["accounts"][account_id] = {
                "password": self.settings.value("password", "", str),
                "nickname": self.settings.value("nickname", "", str),
                # "sites" は現状未使用だが、将来的にサイトごとの設定に使える
                # "sites": self.settings.value("sites", [], list)
            }
            self.settings.endGroup()
        self.settings.endGroup()
        
        # その他の設定を読み込む
        settings_dict["selected_sites"] = self.settings.value("selected_sites", self.default_settings["selected_sites"], list)
        settings_dict["auto_login"] = self.settings.value("auto_login", self.default_settings["auto_login"], bool)
        settings_dict["remember_accounts"] = self.settings.value("remember_accounts", self.default_settings["remember_accounts"], bool)
        settings_dict["default_account"] = self.settings.value("default_account", self.default_settings["default_account"], str)
        settings_dict["api_key"] = self.settings.value("api_key", self.default_settings["api_key"], str)
        settings_dict["application_id"] = self.settings.value("application_id", self.default_settings["application_id"], str)
        settings_dict["affiliate_id"] = self.settings.value("affiliate_id", self.default_settings["affiliate_id"], str)
        
        return settings_dict
    
    def save_settings(self, settings_dict):
        """
        設定を保存する
        """
        # アカウント情報の保存 (個別メソッドに任せる)
        # self.save_all_accounts(settings_dict.get("accounts", {}))

        # その他の設定を保存
        if "selected_sites" in settings_dict:
            self.settings.setValue("selected_sites", settings_dict["selected_sites"])
        if "auto_login" in settings_dict:
            self.settings.setValue("auto_login", settings_dict["auto_login"])
        if "remember_accounts" in settings_dict:
            self.settings.setValue("remember_accounts", settings_dict["remember_accounts"])
        if "default_account" in settings_dict:
            self.settings.setValue("default_account", settings_dict["default_account"])
        if "api_key" in settings_dict:
            self.settings.setValue("api_key", settings_dict["api_key"])
        if "application_id" in settings_dict:
            self.settings.setValue("application_id", settings_dict["application_id"])
        if "affiliate_id" in settings_dict:
            self.settings.setValue("affiliate_id", settings_dict["affiliate_id"])
            
        # 確実に設定を保存
        self.settings.sync()
        

    def save_account(self, account_id, password, nickname="", amazon_type=None):
        """
        アカウント情報を保存(今後ECサイトを追加していく)
        """
        if amazon_type is None:
            amazon_type = AmazonAccountType.CONSUMER # デフォルトは一般ユーザー
        
        if not self.settings.value("remember_accounts", True, bool):
            print("アカウント記憶が無効のため保存しません。")
            return
            
        self.settings.beginGroup("accounts")
        self.settings.beginGroup(account_id)
        # パスワードはセキュリティを考慮し、別途暗号化/復号の仕組みを推奨
        self.settings.setValue("password", password)
        self.settings.setValue("nickname", nickname)
        
        # 新規追加項目(Amazon)
        self.settings.setValue("amazon_type", amazon_type.value)
        self.settings.setValue("created_at", QDateTime.currentDateTime().toString())
        self.settings.setValue("last_login", "")
        self.settings.setValue("setup_completed", not amazon_type.requires_setup)
        
        self.settings.endGroup()
        self.settings.endGroup()
        self.settings.sync()
        print(f"アカウント '{account_id}' を保存しました。 (タイプ: {amazon_type.display_name})")
        
    
    # save_accountメソッドの後に新しいメソッドを追加（末尾に追加？）
    def get_account_amazon_type(self, account_id):
        """アカウントのAmazonタイプを取得"""
        accounts = self.settings.value("accounts", {})
        account_data = accounts.get(account_id, {})
        
        # 互換性のため、amazon_typeがない古いアカウントはCONSUMERとして使う
        type_value = account_data.get("amazon_type", "consumer")
        
        # Enumに変換
        for amazon_type in AmazonAccountType:
            if amazon_type.value == type_value:
                return amazon_type
        return AmazonAccountType.CONSUMER
        
    
    def update_setup_status(self, account_id, completed=True):
        """新規出品者の設定完了状態を更新"""
        self.settings.beginGroup("accounts")
        if account_id in self.settings.childGroups():
            self.settings.beginGroup(account_id)
            self.settings.setValue("setup_completed", completed)
            if completed:
                self.settings.setValue("setup_completed_at", QDateTime.currentDateTime().toString())
            self.settings.endGroup()
        self.settings.endGroup()
        self.settings.sync()
        print(f"アカウント '{account_id}' の設定状態を更新しました: {'完了' if completed else '未完了'}")
    
    def get_accounts(self):
        """
        保存されている全てのアカウント情報を取得
        get_accountsメソッドを更新
        """
        accounts = {}
        self.settings.beginGroup("accounts")
        account_ids = self.settings.childGroups()
        for account_id in account_ids:
            self.settings.beginGroup(account_id)
            accounts[account_id] = {
                "password": self.settings.value("password", "", str),
                "nickname": self.settings.value("nickname", "", str),
                "amazon_type": self.settings.value("amazon_type", "consumer", str),
                "created_at": self.settings.value("created_at", "", str),
                "last_login": self.settings.value("last_login", "", str),
                "setup_completed": self.settings.value("setup_completed", True, bool)
            }
            self.settings.endGroup()
        self.settings.endGroup()
        return accounts
    
    def delete_account(self, account_id):
        """
        アカウント情報を削除する
        """
        self.settings.beginGroup("accounts")
        if account_id in self.settings.childGroups():
            # グループごと削除するのが確実
            self.settings.remove(account_id)
            print(f"アカウント '{account_id}' を削除しました。")
        else:
            print(f"アカウント '{account_id}' は見つかりませんでした。")
        self.settings.endGroup()
        self.settings.sync()

        
        # デフォルトアカウントも更新
        current_default = self.settings.value("default_account", "")
        if current_default == account_id:
            self.settings.setValue("default_account", "")
            print("デフォルトアカウントをリセットしました。")
            self.settings.sync()

    def save_api_settings(self, api_key, application_id, affiliate_id=None, callback_domain=None):
        """APIキー情報を保管する"""
        # ここでも暗号化を検討
        self.settings.setValue("api_key", api_key)
        self.settings.setValue("application_id", application_id)
        if affiliate_id is not None: # Noneを保存しないように
            self.settings.setValue("affiliate_id", affiliate_id)
        if callback_domain:
            self.settings.setValue("callback_domain", callback_domain)
        else:
            self.settings.remove("affiliate_id") # Noneの場合は削除
        self.settings.sync()

    def get_api_settings(self):
        """APIキー情報を取得する"""
        return {
            "api_key": self.settings.value("api_key", "", str),
            "application_id": self.settings.value("application_id", "", str),
            "affiliate_id": self.settings.value("affiliate_id", "", str),
            "callback_domain": self.settings.value("callback_domain", "", str)
        }
        
    def export_accounts_data(self):
        """
        アカウントデータをエクスポート用に整形
        
        Returns:
            dict: エクスポート用データ辞書
            
        機能:
        - 現在保存されているアカウント情報を取得
        - エクスポート用のメタデータを追加
        - JSON形式での出力に適した形式に整形
        """
        try:
            # 既存のget_accounts()メソッドを使用してアカウント取得
            accounts = self.get_accounts()
            
            # 現在時刻の取得（PyQt6のQDateTime使用）
            from PyQt6.QtCore import QDateTime
            current_time = QDateTime.currentDateTime().toString("yyyy-MM-dd hh:mm:ss")
            
            # エクスポート用データを構築
            export_data = {
                "export_date": current_time,
                "export_version": "BOX0.1_v2.2.0", # バージョン情報
                "total_accounts": len(accounts),
                "accounts": accounts
            }
            
            print(f"✅ エクスポートデータ作成完了: {len(accounts)}個のアカウント")
            return export_data
        
        except Exception as e:
            print(f"❌ エクスポートデータ作成中にエラー: {e}")
            # エラー時は空のデータを返す
            return {
                "export_date": "エラー発生",
                "export_version": "BOX0.1_v2.2.0",
                "total_accounts": 0,
                "accounts": {}
            }
        
    def import_accounts_data(self, import_data):
        """
        アカウントデータをインポート
        
        Args:
            import_data (dict): インポート用データ辞書
            
        Returns:
            int: インポートされたアカウント数
            
        Raises:
            ValueError: 無効なファイル形式の場合
            
        機能:
        - エクスポートされたアカウント情報を読み込み
        - 既存のsave_account()メソッドを使用して安全に保存
        - インポート成功件数をカウントして返却
        """
        try:
            print("📥 インポートデータ検証中...")
            
            # データ形式の検証
            if not isinstance(import_data, dict):
                raise ValueError("インポートデータが辞書形式ではありません")
            
            if 'accounts' not in import_data:
                raise ValueError("'accounts'キーが見つかりません")
            
            accounts_to_import = import_data['accounts']
            if not isinstance(accounts_to_import, dict):
                raise ValueError("アカウントデータが辞書形式ではありません")
            
            print(f"📊 インポート対象: {len(accounts_to_import)}個のアカウント")
            
            # アカウントを1つずつ
            imported_count = 0
            failed_count = 0
            
            for account_id, account_data in accounts_to_import.items():
                try:
                    # アカウントデータの検証
                    if not isinstance(account_data, dict):
                        print(f"⚠️  スキップ: {account_id} (データ形式エラー)")
                        failed_count += 1
                        continue
                        
                    # パスワードとニックネームを取得
                    password = account_data.get('password', '')
                    nickname = account_data.get('nickname', '')
                    
                    if not password:
                        print(f"⚠️  スキップ: {account_id} (パスワードが空)")
                        failed_count += 1
                        continue
                    
                    # 既存のsave_account()メソッドを使用して安全に保存
                    self.save_account(account_id, password, nickname)
                    print(f"✅ インポート成功: {nickname or account_id}")
                    imported_count += 1
                
                except Exception as e:
                    print(f"❌ インポート失敗: {account_id} - {e}")
                    failed_count += 1
                    continue
                
            # 結果サマリー
            print(f"\n📋 インポート結果:")
            print(f"  ✅ 成功: {imported_count}個")
            print(f"  ❌ 失敗: {failed_count}個")
            print(f"  📊 合計: {imported_count + failed_count}個")
            
            return imported_count
        
        except ValueError as ve:
            print(f"❌ データ検証エラー: {ve}")
            raise ve
        except Exception as e:
            print(f"❌ インポート処理エラー: {e}")
            raise Exception(f"インポート処理中にエラーが発生しました: {e}")
        
    def create_backup_data(self):
        """
        完全バックアップデータを作成
        
        Returns:
            dict: バックアップ用データ辞書
            
        機能:
        - アカウント情報の完全バックアップ
        - 設定情報の完全バックアップ
        - メタデータ付きの包括的なデータ作成
        """
        try:
            print("💾 バックアップデータ作成中...")
            
            # 現在時刻の取得
            from PyQt6.QtCore import QDateTime
            current_time = QDateTime.currentDateTime().toString("yyyy-MM-dd hh:mm:ss")
            
            # アカウント情報を取得
            accounts = self.get_accounts()
            print(f"📊 バックアップ対象アカウント: {len(accounts)}個")
            
            # 設定情報を取得
            settings_data = self.load_settings()
            print(f"📊 バックアップ対象設定: {len(settings_data)}項目")
            
            # バックアップデータを構築
            backup_data = {
                # メタデータ
                "backup_date": current_time,
                "backup_version": "BOX0.1_v2.2.0",
                "backup_type": "complete",
                
                # データ統計
                "statistics": {
                    "total_accounts": len(accounts),
                    "total_settings": len(settings_data),
                    "backup_size": "calculated_later"
                },
                
                # 実際のデータ
                "accounts": accounts,
                "settings": settings_data,
                
                # バックアップ設定
                "backup_config": {
                    "include_passwords": True,
                    "include_settings": True,
                    "compression": False,
                    "encryption": False
                }
            }
            
            # データサイズ計算（概算）
            import json
            json_str = json.dumps(backup_data, ensure_ascii=False)
            backup_size_kb = len(json_str.encode('utf-8')) / 1024
            backup_data["statistics"]["backup_size"] = f"{backup_size_kb:.2f}KB"
            
            print(f"💾 バックアップデータ作成完了:")
            print(f"  📁 アカウント: {backup_data['statistics']['total_accounts']}個")
            print(f"  ⚙️  設定項目: {backup_data['statistics']['total_settings']}項目") 
            print(f"  📊 データサイズ: {backup_data['statistics']['backup_size']}")
            print(f"  📅 作成日時: {backup_data['backup_date']}")
            
            return backup_data
        
        except Exception as e:
            print(f"❌ バックアップデータ作成エラー: {e}")
            # エラー時は最小限のバックアップデータを返す
            return {
                "backup_date": "エラー発生",
                "backup_version": "BOX0.1_v2.2.0",
                "backup_type": "error",
                "statistics": {
                    "total_accounts": 0,
                    "total_settings": 0,
                    "backup_size": "0KB"
                },
                "accounts": {},
                "settings": {},
                "error": str(e)
            }
        
        
# 設定ダイアログクラス
class SettingsDialog(QDialog):
    def __init__(self, app_settings: AppSettings, parent=None): # 型ヒントを追加
        super().__init__(parent)
        self.app_settings = app_settings
        # ダイアログを開くたびに最新の設定をロード
        self.settings_data = app_settings.load_settings()
        
        self.setWindowTitle("アプリケーション設定")
        self.setMinimumWidth(500)
        # self.setMinimumHeight(400) # 固定高さより可変の方が良い場合も
        
        self.init_ui()
    
    def init_ui(self):
        # メインレイアウト
        main_layout = QVBoxLayout(self) # selfを親に設定
        
        # タブウィジェット
        self.tab_widget = QTabWidget()
        
        # アカウント設定タブ
        account_tab = QWidget()
        account_layout = QVBoxLayout(account_tab) # 親ウィジェットを設定
        
