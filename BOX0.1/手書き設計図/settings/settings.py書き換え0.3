def get_app_stylesheet():
    """アプリケーション全体のスタイルシートを渡す"""
    return f"""
    /* 全体のベーススタイル */
    QWidget {{
        background-color: {UITheme.COLORS['bg_primary']};
        color: {UITheme.COLORS['text_primary']};
        font-family: {UITheme.FONTS['family']};
        font-size: {UITheme.FONTS['size_md']};
    }}
    /* ダイアログ */
    QDialog {{
        background-color: {UITheme.COLORS['bg_primary']};
        border-radius: 8px;
    }}
    /* グループボックス */
    QGroupBox {{
        background-color: {UITheme.COLORS['bg_secondary']};
        border: 1px solid {UITheme.COLORS['border']};
        border-radius: 8px;
        margin-top: 12px;
        padding: {UITheme.SPACING['md']}px;
        padding-top: {UITheme.SPACING['lg']}px;
    }}
    
    QGroupBox::title {{
        color: {UITheme.COLORS['text_secondary']};
        font-size: {UITheme.FONTS['size_sm']};
        font-weight: {UITheme.FONTS['weight_medium']};
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0 8px;
        background-color: {UITheme.COLORS['bg_secondary']};
        subcontrol-position: top left;
        subcontrol-origin: margin;
        left: 8px;
        top: -8px;
    }}
    
    QLabel {{
        color: {UITheme.COLORS['text_primary']};
        background-color: transparent;
    }}
    QLabel[class="heading"] {{
        font-size: {UITheme.FONTS['size_xl']};
        font-weight: {UITheme.FONTS['weight_bold']};
        color: {UITheme.COLORS['text_primary']};
        margin-bottom: {UITheme.SPACING['sm']}px;
    }}
    QLabel[class="subheading"] {{
        font-size: {UITheme.FONTS['size_lg']};
        font-weight: {UITheme.FONTS['weight_medium']};
        color: {UITheme.COLORS['text_secondary']};
        margin-bottom: {UITheme.SPACING['xs']}px;
    }}
    QLabel[class="caption"] {{
        font-size: {UITheme.FONTS['size_sm']};
        color: {UITheme.COLORS['text_secondary']};
    }}
    
    /* テキスト入力。後で */
    """

def apply_modern_theme(app):
    app.setStyleSheet(get_app_stylesheet())

# AccountDialogクラスの__init__メソッド内で使用する
def style_account_dialog(dialog):
    """アカウントダイアログ専用のスタイリング"""
    dialog.setWindowFlags(Qt.WindowType.Dialog | Qt.WindowType.FramelessWindowHint)
    dialog.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
    
    # 影付きの丸角ウィンドウ
    dialog.setStyleSheet(f"""
        QDialog {{
            background-color: {UITheme.COLORS['bg_primary']};
            border-radius: 12px;
            border: 1px solid {UITheme.COLORS['border']};
        }}
    """)
    
    # windowに影を追加
    shadow = QGraphicsDropShadowEffect()
    shadow.setBlurRadius(20)
    shadow.setColor(QColor(0, 0, 0, 50))
    shadow.setOffset(0, 4)
    dialog.setGraphicsEffect(shadow)  # ← shadow を渡す

