    def _create_tabs(self):
        """すべてのタブを作成"""
        # 実行タブ
        self.main_tab = ExecutionTab(self.parent)
        self.tab_widget.addTab(self.main_tab, "実行")
        
        # アカウント管理タブ
        self.accounts_tab = AccountsManagementTab(self.parent)
        self.tab_widget.addTab(self.accounts_tab, "アカウント管理")
        
        # # ユーザー設定タブ
        # self.settings_tab = UserSettingsTab(self.parent)
        # self.tab_widget.addTab(self.settings_tab, "ユーザー設定")
        
        # ログ・ステータスタブ
        # self.log_tab = LogStatusTab(self.parent)
        # self.tab_widget.addTab(self.log_tab, "ログ・ステータス")
        
        # タブ参照を保存[親ウィンドウからアクセスできるように]
