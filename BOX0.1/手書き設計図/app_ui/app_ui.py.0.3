class ExecutionTab(QWidget):
    """メイン実行タブ"""
    def __init__(self, main_window):
        super().__init__()
        self.main_window = main_window
        self.init_ui()
    
    def init_ui(self):
        """UI初期化"""
        layout = QVBoxLayout()
        layout.setSpacing(16)  # ← 修正
        layout.setContentsMargins(20, 20, 20, 20)  # ← 修正
        
        # タイトル
        title = QLabel("ログイン")
        title.setStyleSheet("font-size: 20px; font-weight: bold; color: #1976d2;")
        layout.addWidget(title)
        
        # アカウント選択セクション
        account_group = QGroupBox("アカウント選択")
        account_layout = QVBoxLayout()
        
        self.account_combo = QComboBox()
        self.account_combo.setMinimumHeight(45)
        account_layout.addWidget(self.account_combo)
        
        account_group.setLayout(account_layout)
        layout.addWidget(account_group)
        # ECサイト選択セクション
        sites_group = QGroupBox("ECサイト選択")
        sites_layout = QVBoxLayout()
        
        # サイトリスト
        self.ec_sites = ["楽天市場", "Amazon", "Yahoo!ショッピング", "auワウマ"]
        self.list_widget = QListWidget()
        self.list_widget.setMinimumHeight(220)
        self.site_checkboxes = {}
        
        for site in self.ec_sites:
            # QListWidgetItemを作成
            item = QListWidgetItem()
            self.list_widget.addItem(item)
            
            # チェックボックスを作成してセット
            checkbox = QCheckBox(site)
            checkbox.setStyleSheet("""
                QCheckBox {
                    padding: 12px;
                    font-size: 14px;
                    min-height: 24px;
                }
                QCheckBox:hover {
                    background-color: rgba(25, 118, 210, 0.1);
                    border-radius: 4px;
                }
            """)
            self.list_widget.setItemWidget(item, checkbox)
            self.site_checkboxes[site] = checkbox
            
        sites_layout.addWidget(self.list_widget)  # ★ 変更
        sites_group.setLayout(sites_layout)
        layout.addWidget(sites_group)
        
        # 実行ボタンセクション
        button_layout = QHBoxLayout()
        button_layout.setSpacing(12)
        
        self.start_button = QPushButton("ログイン開始")
        self.start_button.setObjectName("primaryButton")
        self.start_button.setMinimumHeight(48)
        
        
        button_layout.addWidget(self.start_button)
        layout.addLayout(button_layout)
        
        # ステータス表示
        self.status_label = QLabel("待機中...")
        self.status_label.setProperty("class", "caption")
        layout.addWidget(self.status_label)
        
        # プログレバー
        self.progress_bar = QProgressBar()
        self.progress_bar.setMinimumHeight(8)
        self.progress_bar.setTextVisible(False)
        layout.addWidget(self.progress_bar)
        
        # 余白を追加
        layout.addStretch()
        self.setLayout(layout)
    
    def get_selected_sites(self):
        """選択されたサイトのリストを取得"""
        selected = []
        for site, checkbox in self.site_checkboxes.items():
            if checkbox.isChecked():
                selected.append(site)
        return selected

class AccountsManagementTab(QWidget):
    """アカウント管理タブ"""
    def __init__(self, main_window):
        super().__init__()
        self.main_window = main_window
        self.init_ui()
    
    def init_ui(self):
        """UI初期化"""
        layout = QVBoxLayout()
        layout.setSpacing(16)
        layout.setContentsMargins(20, 20, 20, 20)
        
        # タイトル
        title = QLabel("アカウント管理")
        title.setProperty("class", "heading")
        layout.addWidget(title)
        
        # アカウントリスト
        self.accounts_list = QListWidget()
        self.accounts_list.setMinimumHeight(400)
        layout.addWidget(self.accounts_list)
        
        # ボタンレイアウト追加
        buttons_layout = QHBoxLayout()
        buttons_layout.setSpacing(12)
        
        add_button = QPushButton("追加")
        add_button.setObjectName("primaryButton")
        add_button.setMinimumHeight(40)
        
        edit_button = QPushButton("編集")
        edit_button.setMinimumHeight(40)
        
        delete_button = QPushButton("削除")
        delete_button.setObjectName("dangerButton")
        delete_button.setMinimumHeight(40)
        
        buttons_layout.addWidget(add_button)
        buttons_layout.addWidget(edit_button)
        buttons_layout.addWidget(delete_button)
        buttons_layout.addStretch()
        
        layout.addLayout(buttons_layout)
        
        # ボタンを保存（親ウィンドウからアクセス用）
        self.add_button = add_button
        self.edit_button = edit_button
        self.delete_button = delete_button
        
        self.setLayout(layout)
        
    

class LogStatusTab(QWidget): #クラスは残っていますが、どこからも使われていないので削除しても問題ありません。ただし、将来使う可能性があるなら残しておいても害はない
    """ログ・ステータスタブ"""
    def __init__(self, main_window):
        super().__init__()
        self.main_window = main_window
        self.init_ui()

    def init_ui(self):
        """UI初期化"""
        layout = QVBoxLayout()
        layout.setSpacing(16)
        layout.setContentsMargins(20, 20, 20, 20)
        
        # タイトル
        title = QLabel("ログ・ステータス")
        title.setProperty("class", "heading")
        layout.addWidget(title)
        
        # コントロールボタン
        controls_layout = QHBoxLayout()
        
        clear_button = QPushButton("クリア")
        clear_button.setMaximumWidth(120)
        
        export_button = QPushButton("エクスポート")
        export_button.setMaximumWidth(120)
        
        controls_layout.addWidget(clear_button)
        controls_layout.addWidget(export_button)
        controls_layout.addStretch()
        
        layout.addLayout(controls_layout)
        
        # ログ表示エリア
        self.log_text = QTextEdit()
        self.log_text.setReadOnly(True)
        layout.addWidget(self.log_text)
        
        # ボタンを保存
        self.clear_button = clear_button
        self.export_button = export_button
        
        self.setLayout(layout)
    
    # 2025/11/01_add_logメソッドを追加
    def add_log(self, message):
        """
        ログメッセージを追加
        
        Args:
            message (str): 追加するログメッセージ
        """
        try:
            timestamp = QDateTime.currentDateTime().toString("hh:mm:ss")
            self.log_text.append(f"[{timestamp}] {message}")
        except Exception as e:
            print(f"ログ追加エラー: {e}")
