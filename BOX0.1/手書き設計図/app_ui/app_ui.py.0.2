# -*- coding: utf-8 -*-
"""
UIコンポーネント専用モジュール
メインウィンドウズとタブのUI定義を管理
"""
from PyQt6.QtWidgets import (QWidget, QPushButton, QVBoxLayout, QHBoxLayout,
                            QListWidget, QListWidgetItem, QCheckBox, QLabel,
                            QProgressBar, QComboBox, QGroupBox, QTextEdit,
                            QTabWidget, QDialog, QMessageBox
                            )
from PyQt6.QtCore import Qt, pyqtSignal, QDateTime
from PyQt6.QtGui import QFont
from settings import  UITheme, get_app_stylesheet # モダンUI設定をインポート

class MainUI:
    """メインウィンドウのUI構築を担当するクラス"""
    def __init__(self, parent):
        self.parent = parent
        self.setup_ui()
    
    def setup_ui(self):
        """UI初期化"""
        # ウィンドウ設定
        self.parent.setWindowTitle("ECテイト自動ログインシステム")
        self.parent.setGeometry(100, 100, 1000, 800)
        
        # モダンスタイルを適用
        self.apply_modern_style()
        
        # メインレイアウト
        main_layout = QVBoxLayout()
        
        # タブウィジェット作成
        self.tab_widget = QTabWidget()
        self.tab_widget.setDocumentMode(True) # モダンなタブスタイル
        
        # 各タブを作成
        self._create_tabs()
        
        main_layout.addWidget(self.tab_widget)
        self.parent.setLayout(main_layout)
    
    def apply_modern_style(self):
        """
        モダンなスタイルを適用
        アプリケーション全体のスタイルシートはmain.pyで設定
        ここではウィンドウ固有のスタイルを設定
        """
        self.parent.setStyleSheet(f"""
            QMainWindow {{
                background-color: {UITheme.COLORS['bg_primary']};
            }}
        """)
    
    def _create_tabs(self):
        """すべてのタブを作成"""
        # 実行タブ
        main_tab = ExecutionTab(self.parent)
        self.tab_widget.addTab(main_tab, "実行")
        
        # アカウント管理タブ
        accounts_tab = AccountsManagementTab(self.parent)
        self.tab_widget.addTab(accounts_tab, "アカウント管理")
        
        # ユーザー設定タブ
        settings_tab = UserSettingsTab(self.parent)
        self.tab_widget.addTab(settings_tab, "ユーザー設定")
        
        # ログ・ステータスタブ
        log_tab = LogStatusTab(self.parent)
        self.tab_widget.addTab(log_tab, "ログ・ステータス")
        
        # タブ参照を保存[親ウィンドウからアクセスできるように]
        self.parent.main_tab = main_tab
        self.parent.accounts_tab = accounts_tab
        self.parent.settings_tab = settings_tab
        self.parent.log_tab = log_tab

class ExecutionTab(QWidget):
    """メイン実行タブ"""
    def __init__(self, main_window):
        super().__init__()
        self.main_window = main_window
        self.init_ui()
    
    def init_ui(self):
        """UI初期化"""
        layout = QVBoxLayout()
        layout.setSpacing(UITheme.SPACING['md'])
        layout.setContentsMargins(
            UITheme.SPACING['lg'], UITheme.SPACING['lg'],
            UITheme.SPACING['lg'], UITheme.SPACING['lg']
        )
        # タイトル
        title = QLabel("ログイン")
        title.setProperty("class", "heading")
        layout.addWidget(title)
        # アカウント選択セクション
        account_group = QGroupBox("アカウント選択")
        account_layout = QVBoxLayout()
        
        self.account_combo = QComboBox()
        self.account_combo.setMinimumHeight(40)
        account_layout.addWidget(self.account_combo)
        
        account_group.setLayout(account_layout)
        layout.addWidget(account_group)
        # ECサイト選択セクション
        sites_group = QGroupBox("ECサイト選択")
        sites_layout = QVBoxLayout()
        
        # サイトリスト
        self.ec_sites = ["楽天市場", "Amazon", "Yahoo!ショッピング", "auワウマ"]
        self.site_checkboxes = {}
        
        for site in self.ec_sites:
            checkbox = QCheckBox(site)
            checkbox.setStyleSheet("""
                QCheckBox {
                    padding: 8px;
                    font-size 14px;
                }
                QCheckBox:hover {
                    background-color: rgba(74, 158, 255, 0.1);
                    border-radius: 4px;
                }
            """)
            self.site_checkboxes[site] = checkbox
            sites_layout.addWidget(checkbox)
        sites_group.setLayout(sites_layout)
        layout.addWidget(sites_group)
        
        # 実行ボタンセッション
        button_layout = QHBoxLayout()
        button_layout.setSpacing(UITheme.SPACING['md'])
        
        self.start_button = QPushButton("ログイン開始")
        self.start_button.setObjectName("primaryButton")
        self.start_button.setMinimumHeight(48)
        self.start_button.setFont(QFont(UITheme.FONTS['family'], 14))
        
        self.stop_button = QPushButton("停止")
        self.stop_button.setObjectName("dangerButton")
        self.stop_button.setMinimumHeight(48)
        self.stop_button.setEnabled(False)
        
        button_layout.addWidget(self.start_button)
        button_layout.addWidget(self.stop_button)
        layout.addLayout(button_layout)
        
        # ステータス表示
        self.status_label = QLabel("待機中...")
        self.status_label.setProperty("class", "caption")
        layout.addWidget(self.status_label)
        
        # プログレバー
        self.progress_bar = QProgressBar()
        self.progress_bar.setMinimumHeight(8)
        self.progress_bar.setTextVisible(False)
        layout.addWidget(self.progress_bar)
        
        # 余白を追加
        layout.addStretch()
        self.setLayout(layout)
    
    def get_selected_sites(self):
        """選択されたサイトのリストを取得"""
        selected = []
        for site, checkbox in self.site_checkboxes.items():
            if checkbox.isChecked():
                selected.append(site)
        return selected

