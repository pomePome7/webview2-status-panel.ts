# 💾 ユーザー設定記憶機能クラス
# ========================================

class UserPreferencesManager:
    """ユーザー情報記憶機能（データ管理層）"""
    def __init__(self, settings: QSettings):
        self.settings = settings

    def save_user_preferences(self, preferences):
        """ユーザー設定を保存"""
        self.settings.beginGroup("user_preferences")
        for key, value in preferences.items():
            self.settings.setValue(key, value)
        self.settings.endGroup()
        self.settings.sync()

    def load_user_preferences(self):
        """ユーザー設定を読み込み"""
        preferences = {}
        self.settings.beginGroup("user_preferences")
        for key in self.settings.childKeys():
            preferences[key] = self.settings.value(key)
        self.settings.endGroup()
        return preferences

    def get_preference(self, key, default_value=None):
        """特定の設定値を取得"""
        self.settings.beginGroup("user_preferences")
        value = self.settings.value(key, default_value)
        self.settings.endGroup()
        return value

    def set_preference(self, key, value):
        """特定の設定値を保存"""
        self.settings.beginGroup("user_preferences")
        self.settings.setValue(key, value)
        self.settings.endGroup()
        self.settings.sync()
        
    def increment_stat(self, stat_name):
        """使用統計をインクリメント"""
        current_value = self.get_preference(stat_name, 0)
        self.set_preference(stat_name, current_value + 1)
        return current_value + 1
        
    def get_usage_stats(self):
        """使用統計を取得"""
        return {
            "accounts_added": self.get_preference("accounts_added", 0),
            "accounts_deleted": self.get_preference("accounts_deleted", 0),
            "login_attempts": self.get_preference("login_attempts", 0),
            "successful_logins": self.get_preference("successful_logins", 0),
            "last_usage_date": self.get_preference("last_usage_date", "未記録")
        }

